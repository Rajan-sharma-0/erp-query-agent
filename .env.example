# ============================================
# LLM PROVIDER SELECTION
# ============================================
# Choose your LLM provider: ollama | gemini | openai
LLM_PROVIDER=ollama

# ============================================
# Ollama Configuration (LOCAL - Default)
# ============================================
# No API key needed. Requires Ollama running locally.
# Download from: https://ollama.ai
# Run: ollama pull gemma3:1b
OLLAMA_MODEL=gemma3:1b
OLLAMA_HOST=http://localhost:11434

# ============================================
# Google Gemini Configuration (CLOUD - Recommended)
# ============================================
# Fast, accurate, affordable. Get API key: https://aistudio.google.com/app/apikeys
# UNCOMMENT next line and set LLM_PROVIDER=gemini to use Gemini
# GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# OpenAI Configuration (CLOUD - Most Accurate)
# ============================================
# Highest accuracy for MongoDB queries. Get API key: https://platform.openai.com/api-keys
# UNCOMMENT next line and set LLM_PROVIDER=openai to use OpenAI
# OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# MongoDB Database
# ============================================
# Get connection string from: https://cloud.mongodb.com/v2
MONGODB_URI=<your-mongodb-atlas-connection-string>
DATABASE_NAME=erp_db
